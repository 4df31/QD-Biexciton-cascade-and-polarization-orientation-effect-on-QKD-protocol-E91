Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalGamma]", "[", 
     RowBox[{"\[CapitalAlpha]_", ",", "\[CapitalBeta]_"}], "]"}], ":=", 
    RowBox[{"ArrayFlatten", "[", 
     RowBox[{
      RowBox[{"TensorProduct", "[", 
