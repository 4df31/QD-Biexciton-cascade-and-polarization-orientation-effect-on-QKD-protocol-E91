           "\[CapitalPhi]"}], "]"}]}], "]"}], ",", "2"}], "]"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["p", "pm"], "=", 
