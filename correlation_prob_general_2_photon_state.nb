Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"Pcorr", "[", 
    RowBox[{"\[Phi]_", ",", "\[CapitalTheta]_"}], "]"}], " ", ":=", " ", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"Power", "[", 
       RowBox[{
        RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", "4"}], "]"}], "+", 
      RowBox[{"Power", "[", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Phi]", "]"}], ",", "4"}], "]"}], " ", "+", " ", 
      RowBox[{"2", "*", 
       RowBox[{"(", 
        RowBox[{"Power", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Sin", "[", "\[Phi]", "]"}], "*", 
           RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", "2"}], "]"}], ")"}], "*", 
       RowBox[{"Cos", "[", "\[CapitalTheta]", "]"}]}]}], ")"}], "/", "2"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.979687584587373*^9, 3.9796877384233522`*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"bd76fc98-3845-4c5f-b659-8b75cd34b26a"],

