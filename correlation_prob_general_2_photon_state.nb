Cell[BoxData[{
 RowBox[{
  RowBox[{"\[CapitalPhi]", "=", 
   RowBox[{"{", 
    RowBox[{
     SubscriptBox["\[Alpha]", "0"], ",", 
     SubscriptBox["\[Alpha]", "1"], ",", 
     SubscriptBox["\[Alpha]", "2"], ",", 
     SubscriptBox["\[Alpha]", "3"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   SubscriptBox["p", "pp"], "=", 
   RowBox[{"Assuming", " ", "[", 
    RowBox[{
     RowBox[{"Element", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\[CapitalAlpha]", ",", "\[CapitalBeta]"}], "}"}], ",", 
