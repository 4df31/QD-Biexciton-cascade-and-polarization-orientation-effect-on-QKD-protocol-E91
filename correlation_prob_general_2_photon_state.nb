Notebook[{

Cell[CellGroupData[{
Cell["\<\
Computation of the correlation / anticorrelation Probabilities of a 2 photon \
state polarized. \
\>", "Title",
 CellChangeTimes->{{3.979684425916585*^9, 3.97968448447337*^9}, {
  3.979684558268153*^9, 
  3.9796845651310062`*^9}},ExpressionUUID->"a3a86aea-cf5f-4a6c-96d6-\
1ff6d966a794"],

Cell[CellGroupData[{

Cell["General Definitions", "Section",
 CellChangeTimes->{{3.979684488763404*^9, 3.979684509371538*^9}, {
  3.979684542424555*^9, 
  3.97968454383854*^9}},ExpressionUUID->"79b99f03-c45f-48a2-9d60-\
b9fc02ddba9a"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[<|
     "boxes" -> FormBox["\[CapitalPi]", TraditionalForm], "errors" -> {}, 
      "input" -> "\\Pi", "state" -> "Boxes"|>,
     "TeXAssistantTemplate"], " "}], TraditionalForm]],ExpressionUUID->
  "0d51e9a6-fdb5-4916-8e38-01a9cc693d30"],
 " represents the analyzer operator. reference in the grynberg textbook\
\[LineSeparator]",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Psi]", TraditionalForm], "errors" -> {}, "input" -> 
     "$\\psi$", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "83b71b30-0d17-4287-a0b0-fffb47d866ff"],
 " is the quantum stat that represent the polarized photon with an angle ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|
    "boxes" -> FormBox["\[Theta]", TraditionalForm], "errors" -> {}, "input" -> 
     "\\theta", "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "d8926c49-b1cd-463a-9626-d157b06d5304"],
 " with respect to the ",
 Cell[BoxData[
  FormBox[
   TemplateBox[<|"boxes" -> FormBox[
       RowBox[{"|", 
         StyleBox["H", "TI"], "\[RightAngleBracket]", ", ", "|", 
         StyleBox["V", "TI"], "\[RightAngleBracket]"}], TraditionalForm], 
     "errors" -> {}, "input" -> "$\\Big| H \\rangle,\\,\\Big| V \\rangle $", 
     "state" -> "Boxes"|>,
    "TeXAssistantTemplate"], TraditionalForm]],ExpressionUUID->
  "e89471f8-b52a-402b-8bc1-9e4a65edeb2c"],
 "  basis ket\n"
}], "Text",
 CellChangeTimes->{
  3.979684516969521*^9, {3.979684555082692*^9, 3.979684736397128*^9}, {
   3.979684806176641*^9, 
   3.979684810692415*^9}},ExpressionUUID->"1c6cf583-cbed-4a32-a16e-\
bff580fa4ebe"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[CapitalPi]", "[", "\[Theta]_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Cos", "[", 
         RowBox[{"2", "*", "\[Theta]"}], "]"}], ",", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "\[Theta]"}], "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Sin", "[", 
         RowBox[{"2", "*", "\[Theta]"}], "]"}], ",", 
        RowBox[{"-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", "*", "\[Theta]"}], "]"}]}]}], "}"}]}], "}"}]}], ";"}], 
  
  RowBox[{"(*", 
   RowBox[{
   "\[Theta]", " ", "is", " ", "the", " ", "rotation", " ", "angle", " ", 
    "of", " ", "the", " ", "polarizer", " ", "with", " ", "respect", " ", 
    "to", " ", "the", " ", "x", " ", "axis"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"\[Psi]", "[", "\[Phi]_", "]"}], ":=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Cos", "[", "\[Phi]", "]"}], ",", 
      RowBox[{"Sin", "[", "\[Phi]", "]"}]}], "}"}]}], ";"}], 
  RowBox[{"(*", 
   RowBox[{
   "\[Phi]", " ", "represent", " ", "the", " ", "angle", " ", "that", " ", 
    "makes", " ", "the", " ", "polarization", " ", "of", " ", "the", " ", 
    "photon", " ", "with", " ", "respect", " ", "to", " ", "the", " ", "x", " ", 
    RowBox[{"axis", "."}]}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.979681914054666*^9, 3.9796820875960712`*^9}, {
   3.979682144109419*^9, 3.979682152673306*^9}, 3.979682224423465*^9, {
   3.9796826346310472`*^9, 3.979682635454302*^9}, {3.9796827894288263`*^9, 
   3.97968279377957*^9}, {3.9796848168361797`*^9, 3.9796848660946608`*^9}},
 CellLabel->"In[26]:=",ExpressionUUID->"a3bd5283-73c0-465d-9c5c-8bd11e1526d9"]
}, Open  ]],

